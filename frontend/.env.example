# Backend API base URL
VITE_API_URL=http://localhost:4000/api

# Google Maps browser key: enable Maps JavaScript API and Maps Embed API, billing, and HTTP referrer restrictions.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# Google Maps JavaScript map ID for draggable advanced pins (DEMO_MAP_ID is used for development).
VITE_GOOGLE_MAPS_MAP_ID=

# WhatsApp contact number (international format, no + or spaces)
VITE_WHATSAPP_NUMBER=91XXXXXXXXXX

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
