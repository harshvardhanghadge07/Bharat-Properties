# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/bharat_properties

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS and email links)
CLIENT_URL=http://localhost:5173
PORT=4000

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (for verification & password reset emails)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=Bharat Properties <your@gmail.com>

# Razorpay (get keys at https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
# Set this after creating a webhook in Razorpay Dashboard → Settings → Webhooks
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# WhatsApp inquiry button — number in international format, no + or spaces
WHATSAPP_NUMBER=91XXXXXXXXXX
