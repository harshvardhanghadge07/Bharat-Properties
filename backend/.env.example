# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/bharat_properties

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Frontend URL (for CORS and email links)
CLIENT_URL=http://localhost:5173
PORT=4000

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email — Resend (recommended for cloud/Render — uses HTTPS, never blocked)
# Sign up free at https://resend.com → API Keys → Create API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Without a verified domain use: onboarding@resend.dev (sends to your Resend account email only)
# With a verified domain use: Bharat Properties <noreply@yourdomain.com>
RESEND_FROM=Bharat Properties <onboarding@resend.dev>

# Email — Nodemailer / Gmail (local dev only — SMTP is blocked on Render & most cloud hosts)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_16char_gmail_app_password_nospaces
EMAIL_FROM=Bharat Properties <your@gmail.com>

# Razorpay (get keys at https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
# Set this after creating a webhook in Razorpay Dashboard → Settings → Webhooks
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# WhatsApp inquiry button — number in international format, no + or spaces
WHATSAPP_NUMBER=91XXXXXXXXXX
